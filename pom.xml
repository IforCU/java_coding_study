<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>kr.banklearning</groupId>
  <artifactId>bank-java-learning</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <modules>
    <module>modules/00-bootstrap</module>
    <module>modules/01-java-core</module>
    <module>modules/02-servlet-jsp</module>
    <module>modules/03-spring-mvc</module>
    <module>modules/04-banking-transaction</module>
    <module>modules/05-security-operations</module>
    <module>modules/06-spring-boot</module>
  </modules>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <junit.version>6.1.3</junit.version>
    <postgresql.version>42.7.14</postgresql.version>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
          <configuration><release>17</release></configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.0</version>
          <configuration>
            <systemPropertyVariables>
              <java.io.tmpdir>${project.build.directory}</java.io.tmpdir>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-war-plugin</artifactId>
          <version>3.5.1</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
  <profiles>
    <profile>
      <id>exercise-phase1</id>
      <modules><module>exercises/starter/phase-01</module></modules>
    </profile>
    <profile>
      <id>solution-phase1</id>
      <modules><module>exercises/solutions/phase-01</module></modules>
    </profile>
    <profile>
      <id>exercise-phase2</id>
      <modules><module>exercises/starter/phase-02</module></modules>
    </profile>
    <profile>
      <id>solution-phase2</id>
      <modules><module>exercises/solutions/phase-02</module></modules>
    </profile>
    <profile>
      <id>exercise-phase3</id>
      <modules><module>exercises/starter/phase-03</module></modules>
    </profile>
    <profile>
      <id>solution-phase3</id>
      <modules><module>exercises/solutions/phase-03</module></modules>
    </profile>
    <profile>
      <id>exercise-phase4</id>
      <modules><module>exercises/starter/phase-04</module></modules>
    </profile>
    <profile>
      <id>solution-phase4</id>
      <modules><module>exercises/solutions/phase-04</module></modules>
    </profile>
    <profile>
      <id>exercise-phase5</id>
      <modules><module>exercises/starter/phase-05</module></modules>
    </profile>
    <profile>
      <id>solution-phase5</id>
      <modules><module>exercises/solutions/phase-05</module></modules>
    </profile>
    <profile>
      <id>exercise-phase6</id>
      <modules><module>exercises/starter/phase-06</module></modules>
    </profile>
    <profile>
      <id>solution-phase6</id>
      <modules><module>exercises/solutions/phase-06</module></modules>
    </profile>
    <profile>
      <id>integration-tests</id>
      <build><plugins><plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.6.0</version>
        <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
      </plugin></plugins></build>
    </profile>
  </profiles>
</project>
