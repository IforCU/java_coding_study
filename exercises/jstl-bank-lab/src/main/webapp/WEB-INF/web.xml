<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.0">
  <display-name>은행 JSP 화면 실습</display-name>
  <servlet><servlet-name>accounts</servlet-name><servlet-class>kr.banklearning.jsplab.AccountLabServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>accounts</servlet-name><url-pattern>/accounts</url-pattern></servlet-mapping>
  <welcome-file-list><welcome-file>accounts</welcome-file></welcome-file-list>
